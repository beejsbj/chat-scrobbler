{
  "manifest_version": 3,
  "name": "Chat Scrobbler",
  "version": "0.1.0",
  "description": "Quietly captures your ChatGPT, Claude, and Gemini conversations into a private, searchable archive you own.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["alarms", "cookies", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*.ts.net/*",
    "https://*.ts.net/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://auth.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chat Scrobbler",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
