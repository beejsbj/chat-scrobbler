# Copy to .env next to docker-compose.yml, then `docker compose up -d`.
# .env is ignored by git. Never commit real tokens.

# Required. Generate each with: openssl rand -hex 32
MCP_AUTH_TOKEN=
INGEST_TOKEN=

# Compose files to use. The ports overlay publishes 127.0.0.1:4318 (ingest) and
# 127.0.0.1:4319 (MCP). Remove it behind a reverse proxy. Append
# :docker-compose.no-embedder.yml to leave the bundled embedder out.
COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml

# Data directory on the host. Create it and give it to DATA_UID before the first start:
#   mkdir -p data/canonical/assets && sudo chown -R 999:999 data
# Required. The embedder reads asset blobs from $DATA_DIR/canonical/assets, read-only.
DATA_DIR=./data
# Owner of the data directory. Asset blobs are written 0600 by this user and the embedder
# runs as the same one. Existing data owned by another uid: set both to match.
# DATA_UID=999
# DATA_GID=999

# Optional.
# BIND_ADDRESS=127.0.0.1
# INGEST_PORT=4318
# MCP_PORT=4319
# Name shown in the MCP server instructions ("<name>'s AI chat history").
# CHAT_SCROBBLER_OWNER_NAME=
# Semantic search: embeddinggemma (bundled embedder, default) or none (literal-only search).
# CHAT_SCROBBLER_EMBED_PROVIDER=embeddinggemma
