[Unit]
Description=Refresh web archive aggregates for usage.burooj.dev
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec usage-dashboard chat-scrobbler usage collect --web-only --device bjslab --incremental-days 7 --canonical-dir /data/canonical/sessions --out /data/usage/snapshots/bjslab-web.json
TimeoutStartSec=10min
